# ============================================================
# Home Guardian 环境变量配置
# 使用前请复制此文件：cp .env.example .env
# ============================================================

# ---------- PostgreSQL ----------
# DB_HOST: Docker 内部服务名为 postgres，本地开发时改为 127.0.0.1
DB_HOST=postgres
POSTGRES_USER=guardian_user
POSTGRES_PASSWORD=your_strong_db_password_here
POSTGRES_DB=home_guardian_db
POSTGRES_PORT=5432

# ---------- Redis ----------
# REDIS_HOST: Docker 内部服务名为 redis，本地开发时改为 127.0.0.1
REDIS_HOST=redis
REDIS_PASSWORD=your_strong_redis_password_here
REDIS_PORT=6379

# ---------- Nginx ----------
HTTP_PORT=80
# HTTPS_PORT=443

# ---------- MQTT (EMQX) ----------
# MQTT_HOST: Docker 内部服务名为 emqx（Webman/各进程连 Broker 用的地址）
MQTT_HOST=emqx
MQTT_PORT=1883
# MQTT_PUBLIC_HOST: 设备（ESP32）可达的公网/局域网 MQTT 地址。
#   设备自注册（/api/provisioning/register）时返回此地址让设备连 Broker。
#   不填则回退 MQTT_HOST——但 emqx 是 Docker 内部名，外部设备连不上，
#   所以只要有真机接入就必须设为服务器的公网 IP 或域名，如 203.0.113.10。
#   改动后需 `docker compose up -d --force-recreate webman` 重建容器才生效（env_file 仅创建时读取）。
# MQTT_PUBLIC_HOST=
# Webman 内部 MQTT 客户端的超级用户凭证
MQTT_SUPER_USERNAME=hg_internal_client
MQTT_SUPER_PASSWORD=your_strong_mqtt_password_here

# ---------- JWT ----------
# 请使用 openssl rand -base64 64 生成强密钥
JWT_SECRET=your_jwt_secret_key_here
# access_token 有效期（秒），默认 2 小时
JWT_ACCESS_TTL=7200
# refresh_token 有效期（秒），默认 30 天
JWT_REFRESH_TTL=2592000

# ---------- App ----------
# 调试模式，生产环境务必设为 false
APP_DEBUG=true
# 设备心跳超时（秒）：last_seen 超过此值仍在线的设备，由定时任务置为离线。
# 应大于设备正常上报间隔，避免误判（默认 180，适合约 1 分钟上报一次的设备）。
DEVICE_OFFLINE_TIMEOUT=180
